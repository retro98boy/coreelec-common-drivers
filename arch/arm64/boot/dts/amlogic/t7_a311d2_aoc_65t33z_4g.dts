#include "t7_a311d2_an400_drm_hdmitx_only_debian.dts"
#include "coreelec_t7_common.dtsi"

/ {
	model = "AOC 65T33Z";
	coreelec-dt-id = "t7_a311d2_aoc_65t33z_4g";
	amlogic-dt-id = "t7_a311d2_an400";

	memory@00000000 {
		device_type = "memory";
		linux,usable-memory = <0x00000000 0x00000000 0x00000000 0xe0000000
													0x00000001 0x00000000 0x00000000 0x20000000>;
	};

	auge_sound {
		avout_mute-gpios = <&gpio GPIOY_2 GPIO_ACTIVE_HIGH>; /* APA2172 /SDN */
	};

	/* USB5744 (UU21) VDD12 */
	regulator-usbhub-vdd {
		compatible = "regulator-fixed";
		regulator-name = "usbhub_vdd";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		gpio = <&gpio GPIOC_0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	/* USB5744 (UU1) VDD12 */
	regulator-usbhub2-vdd {
		compatible = "regulator-fixed";
		regulator-name = "usbhub2_vdd";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		gpio = <&gpio GPIOC_1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	/* Android USB Type-A 5V */
	regulator-usb-host {
		compatible = "regulator-fixed";
		regulator-name = "usb_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio GPIOT_23 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	regulator-phy-pwr {
		compatible = "regulator-fixed";
		regulator-name = "phy_pwr";
		gpio = <&gpio GPIOD_9 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	/* from t7_a311d2_an400_drm_hdmitx_only_debian */
	/delete-node/ adc_keypad;
	/delete-node/ gpio_keypad;
	/* from coreelec_t7_common */
	/delete-node/ emmc_pwrseq;
	/delete-node/ vcc5v_reg;
	/delete-node/ sd_3v3;
	/delete-node/ vddio_c;
};

&aml_wifi{
	status = "disabled";
};

&aml_bt {
	status = "disabled";
};

/* Micro USB */
&crg_udc_2 {
	status = "disabled";
};

/* USB Hub */
&crg_udc_3 {
	status = "disabled";
};

/* USB Hub */
&crg20_otg {
	status = "disabled";
	controller-type = <2>;
};

/* Micro USB */
&crg21_otg {
	status = "disabled";
	controller-type = <2>;
};

/* Micro USB */
&crg2_drd {
	/* compatible = "amlogic, crg-drd"; */
	compatible = "amlogic, crg-host-drd";
	status = "okay";
};

/* USB Hub */
&crg3_drd {
	/* compatible = "amlogic, crg-drd"; */
	compatible = "amlogic, crg-host-drd";
	status = "okay";
};

&crg_phy_20 {
	status = "okay";
	portnum = <1>;
	/* from t7_a311d2_an400_drm_hdmitx_only_debian */
	/delete-property/ gpio-vbus-power;
	/delete-property/ gpios;
};

&crg_phy_21 {
	status = "okay";
	portnum = <1>;
	gpio-vbus-power = "GPIOY_16";
	gpios = <&gpio GPIOY_16 GPIO_ACTIVE_HIGH>;
};

&crg3_phy_20 {
	status = "okay";
	portnum = <1>;
};

/*
 * On the A311D2, this Corigine USB module only exposes USB 2.0,
 * which can be used for firmware download during BootROM.
 * Therefore, the port number (portnum) for USB 3.0 is 0.
 */
&crg3_phy_21 {
	status = "okay";
	portnum = <0>;
};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins1>;
	clock-frequency = <400000>;
};

&i2c2 {
	status = "disabled";
};

&i2c5 {
	status = "disabled";
};

&ext_mdio {
	yt8521sc: ethernet-phy@0 {
		reg = <0>;
		max-speed = <1000>;
		reset-assert-us = <20000>;
		reset-deassert-us = <50000>;
		reset-gpios = <&gpio GPIOH_7 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
	};
};

&ethmac {
	pinctrl-0 = <&eth_pins>, <&eth_rgmii_pins>;
	pinctrl-names = "default";
	status = "okay";
	phy-mode = "rgmii";
	phy-handle = <&yt8521sc>;
	internal_phy = <2>;
	mc_val = <0x1621>;
	cali_val = <0xa0000>;
	amlogic,tx-delay-ns = <2>;
};

&sd_emmc_a {
	status = "disabled";
};

&sd_emmc_b {
	status = "disabled";
};

&sd_emmc_c {
	/* from coreelec_t7_common */
	/delete-property/ mmc-pwrseq;
};

&saradc {
	status = "disabled";
};

&pwm_ab {
	status = "disabled";
};

&pwm_ef {
	status = "disabled";
};

&uart_C {
	status = "disabled";
};

/*
 * Increasing the codec_mm_cma size prevents kernel crashes during hardware video decoding.
 * The crash was observed under CoreELEC NO, with the kernel log showing a DMC error.
 */
&codec_mm_cma {
	size = <0x0 0x25800000>;
};
